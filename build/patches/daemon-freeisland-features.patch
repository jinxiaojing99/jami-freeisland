+/** Split "host:port" (v4) or "[v6]:port" (v6). Port is ignored by the ICMP
+ *  probe (L3 host reachability), but kept for address-format validation. */
+static bool
+splitHostPort(const std::string& addr, std::string& host, std::string& port, bool& isV6)
+{
+    if (addr.size() > 2 and addr[0] == '[') {
+        auto close = addr.find(']');
+        if (close == std::string::npos or close + 1 >= addr.size() or addr[close + 1] != ':')
+            return false;
+        host = addr.substr(1, close - 1);
+        port = addr.substr(close + 2);
+        isV6 = true;
+    } else {
+        auto colon = addr.rfind(':');
+        if (colon == std::string::npos)
+            return false;
+        host = addr.substr(0, colon);
+        port = addr.substr(colon + 1);
+        isV6 = false;
+    }
+    return !host.empty() and !port.empty();
+}
+
+#ifdef _WIN32
+/** Windows: IcmpSendEcho (no raw-socket privilege needed). */
+static bool
+icmpReachProbe(const std::string& addr, int timeoutMs = 500)
+{
+    std::string host, port;
+    bool isV6 = false;
+    if (!splitHostPort(addr, host, port, isV6) or isV6)
+        return false;  // IPv6 ICMP needs Icmp6SendEcho; not in scope for P3 gate
+    HANDLE h = IcmpCreateFile();
+    if (h == INVALID_HANDLE_VALUE)
+        return false;
+    unsigned char replyBuf[sizeof(ICMP_ECHO_REPLY) + 32];
+    IPAddr dest = inet_addr(host.c_str());
+    if (dest == INADDR_NONE) {
+        struct hostent* he = gethostbyname(host.c_str());
+        if (!he or he->h_addr_list[0] == nullptr) { IcmpCloseHandle(h); return false; }
+        std::memcpy(&dest, he->h_addr_list[0], 4);
+    }
+    DWORD n = IcmpSendEcho(h, dest, nullptr, 0, nullptr, replyBuf, sizeof(replyBuf), timeoutMs);
+    IcmpCloseHandle(h);
+    if (n == 0)
+        return false;
+    auto* r = reinterpret_cast<ICMP_ECHO_REPLY*>(replyBuf);
+    return r->Status == IP_SUCCESS;
+}
+#else
+/** POSIX (Linux/Android): SOCK_DGRAM ICMP needs no root. */
+static bool
+icmpReachProbe(const std::string& addr, int timeoutMs = 500)
+{
+    std::string host, port;
+    bool isV6 = false;
+    if (!splitHostPort(addr, host, port, isV6) or isV6)
+        return false;
+    int fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_ICMP);
+    if (fd < 0)
+        return false;
+    struct sockaddr_in dest {};
+    dest.sin_family = AF_INET;
+    dest.sin_addr.s_addr = inet_addr(host.c_str());
+    if (dest.sin_addr.s_addr == INADDR_NONE) {
+        struct hostent* he = gethostbyname(host.c_str());
+        if (!he or he->h_addr_list[0] == nullptr) { close(fd); return false; }
+        std::memcpy(&dest.sin_addr, he->h_addr_list[0], 4);
+    }
+    struct icmphdr pkt {};
+    pkt.type = ICMP_ECHO;
+    pkt.un.echo.id = static_cast<uint16_t>(getpid() & 0xffff);
+    pkt.un.echo.sequence = 1;
+    pkt.checksum = 0;
+    // kernel computes checksum for SOCK_DGRAM ICMP
+    if (sendto(fd, &pkt, sizeof(pkt), 0, (struct sockaddr*)&dest, sizeof(dest)) < 0) {
+        close(fd);
+        return false;
+    }
+    timeval tv {timeoutMs / 1000, (timeoutMs % 1000) * 1000};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    char buf[128];
+    struct sockaddr_in from {};
+    socklen_t flen = sizeof(from);
+    ssize_t n = recvfrom(fd, buf, sizeof(buf), 0, (struct sockaddr*)&from, &flen);
+    close(fd);
+    if (n <= 0)
+        return false;
+    auto* rep = reinterpret_cast<struct icmphdr*>(buf);
+    return rep->type == ICMP_ECHOREPLY;
+}
+#endif
+
+/** Backward-compatible name used by the config hook. */
+static bool
+tcpReachProbe(const std::string& addr, int timeoutMs = 500)
+{
+    return icmpReachProbe(addr, timeoutMs);
+}
