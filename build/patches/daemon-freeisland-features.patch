+// P6 (mobile IPv6): periodically nudge OpenDHT's bootstrap state.
+// 30s default (2026-11-26): a 5s interval reset every bucket node's time to
+// min (dht.cpp buckets.connectivityChanged), causing Connected<->Connecting
+// flapping and identity announcement failure. But with keepalive fully off,
+// a 2-node private DHT had no periodic activity and identity announce timed
+// out / never completed (queryPeerServices status=1, messages pending).
+// 30s is infrequent enough not to flap buckets, yet provides the periodic
+// bootstrap ping the 2-node DHT needs. 0 disables explicitly.
+void
+JamiAccount::scheduleDhtKeepalive_()
+{
+    static const int keepaliveSec = [] {
+        const char* e = std::getenv("JAMI_P6_KEEPALIVE_SEC");
+        if (!e)
+            return 30;
+        int v = std::atoi(e);
+        return (v >= 0 && v <= 60) ? v : 30;
+    }();
+    if (keepaliveSec <= 0)
+        return;
+    if (!dhtKeepaliveTimer_)
+        dhtKeepaliveTimer_ = std::make_shared<asio::steady_timer>(*jami::Manager::instance().ioContext());
+    dhtKeepaliveTimer_->expires_after(std::chrono::seconds(keepaliveSec));
+    dhtKeepaliveTimer_->async_wait([w = weak()](const std::error_code& ec) {
+        if (ec)
+            return;
+        auto shared = w.lock();
+        if (!shared)
+            return;
+        if (shared->dht_ && shared->dht_->isRunning()) {
+            // Lightweight liveness ping via bootstrap(). Do NOT use
+            // connectivityChanged() here: it resets every bucket node to
+            // "dubious" (dht.cpp), causing Connected<->Connecting flapping
+            // every interval and preventing the ~10s identity announcement
+            // from ever completing in a 2-node private DHT. bootstrap(addr)
+            // just sends a ping (dhtrunner.cpp) and leaves the routing table
+            // intact, while still generating the DHT activity announce needs.
+            for (const auto& bootstrap : shared->loadBootstrap())
+                shared->dht_->bootstrap(bootstrap);
+        }
+        shared->scheduleDhtKeepalive_(); // re-arm
+    });
+}
+
+// P6 one-side IP change support.
+// The side whose IP changed rebinds nothing (socket bound to "::" follows the
+// new interface address automatically); it just has to send one packet to the
+// peer so the peer learns the new GUA from the packet source (OpenDHT already
+// does cache.getNode(msg->id, from, ...)).
+// The side whose IP stayed fixed hot-updates its bootstrap list from the
+// routing table (exportNodes) so it can re-reach a peer that moved.
+void
+JamiAccount::p6RefreshBootstrap_()
+{
+    auto conf = config();
+    static const bool p6Enabled = [] {
+        const char* e = std::getenv("JAMI_P6_DHT_IPV6");
+#ifdef __ANDROID__
+        return !e || std::string(e) != "0";
+#else
+        return e && std::string(e) == "1";
+#endif
+    }();
+    if (not p6Enabled or not conf.privateDhtOnly or not dht_ or not dht_->isRunning())
+        return;
+    auto now = std::chrono::steady_clock::now();
+    if (now - p6LastBootstrapRefresh_ < std::chrono::seconds(3))
+        return;
+    p6LastBootstrapRefresh_ = now;
+
+    // Fixed-address side (JAMI_P6_BIND_IP6 set, typically PC): learn the peer's
+    // current address from the routing table and hot-update bootstrap. The
+    // mobile side (wildcard bind) must NOT clearBootstrap() -- its bootstrap
+    // entry is how it re-reaches the fixed peer, clearing it broke the link.
+    const char* bindEnv = std::getenv("JAMI_P6_BIND_IP6");
+    const bool fixedSide = bindEnv && *bindEnv;
+    auto nodes = dht_->exportNodes();
+    const auto self = dht_->getPublicKey() ? dht_->getPublicKey()->getId() : dht::InfoHash{};
+    if (fixedSide) {
+        for (const auto& n : nodes) {
+            if (n.addr.getFamily() != AF_INET6 or not n.addr or n.id == self)
+                continue;
+            dht_->clearBootstrap();
+            dht_->bootstrap(n.id, n.addr);
+            JAMI_LOG("[Account {}] P6: refreshed bootstrap from learned peer {}",
+                     getAccountID(), n.addr.toString());
+            return;
+        }
+    }
+
+    // No peer known yet: ping the last configured address so the peer learns
+    // OUR current address (we are the side that moved).
+    for (const auto& bootstrap : loadBootstrap()) {
+        auto resolved = dht::SockAddr::resolve(bootstrap);
+        if (not resolved.empty()) {
+            dht_->bootstrap(resolved.front());
+            JAMI_LOG("[Account {}] P6: probed last known peer {} after network change",
+                     getAccountID(), bootstrap);
+        }
+    }
+}
