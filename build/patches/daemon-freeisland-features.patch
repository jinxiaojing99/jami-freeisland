+// ---------------------------------------------------------------------------
+// P2 (F-905): pairing token APIs. The protocol implementation lives in
+// jamidht/pair_token.h (header-only, self-tested). These are thin wrappers.
+// ---------------------------------------------------------------------------
+namespace {
+
+std::map<std::string, std::string>
+pairInfoToMap(const jami::p2::PairTokenInfo& p)
+{
+    std::map<std::string, std::string> m;
+    m["status"] = p.ok ? "ok" : "error";
+    if (not p.ok) {
+        m["error"] = p.error;
+        return m;
+    }
+    m["aid"] = p.aid;
+    m["did"] = p.did;
+    m["hostname"] = p.hostname;
+    m["fingerprint"] = p.fingerprint;
+    m["nat"] = p.nat;
+    m["v"] = std::to_string(p.v);
+    m["ts"] = std::to_string(p.ts);
+    m["ttl"] = std::to_string(p.ttl);
+    std::string v4, v6;
+    for (const auto& s : p.v4) { if (not v4.empty()) v4 += ";"; v4 += s; }
+    for (const auto& s : p.v6) { if (not v6.empty()) v6 += ";"; v6 += s; }
+    m["v4"] = v4;
+    m["v6"] = v6;
+    m["peerPubkey"] = jami::p2::detail::hexOf(p.pk.data(), p.pk.size());
+    return m;
+}
+
+void
+logPairSelfTestOnce()
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        auto r = jami::p2::pairTokenSelfTest();
+        JAMI_LOG("P2_PAIR_SELFTEST={} PASS={} FAIL={}",
+                 r.fail == 0 ? "PASS" : "FAIL", r.pass, r.fail);
+        if (r.fail)
+            JAMI_WARNING("P2 pairing self-test details:\n{}", r.details);
+    });
+}
+
+} // namespace
+
+std::map<std::string, std::string>
+parsePairToken(const std::string& token)
+{
+    logPairSelfTestOnce();
+    return pairInfoToMap(jami::p2::parsePairToken(token));
+}
+
+std::map<std::string, std::string>
+importPairToken(const std::string& accountId, const std::string& token)
+{
+    logPairSelfTestOnce();
+    auto p = jami::p2::parsePairToken(token);
+    auto ret = pairInfoToMap(p);
+    if (not p.ok) {
+        JAMI_WARNING("[account:{}] P2 import rejected: {}", accountId, p.error);
+        return ret;  // rejected tokens write NOTHING
+    }
+
+    auto account = jami::Manager::instance().getAccount(accountId);
+    if (not account) {
+        ret["status"] = "error";
+        ret["error"] = "account_not_found";
+        return ret;
+    }
+
+    // Reuse the official config hot-reload path: doUnregister -> apply ->
+    // doRegister, so the new bootstrap list is rebuilt without restarting the
+    // application. The private-DHT switch also disables the public DHT proxy.
+    auto details = account->getAccountDetails();
+    details["Account.hostname"] = p.hostname;
+    details["Account.proxyEnabled"] = "false";
+    details[jami::P2_PRIVATE_DHT_ONLY_KEY] = "true";
+    jami::Manager::instance().setAccountDetails(accountId, details);
+    ret["applied"] = "true";
+    JAMI_LOG("[account:{}] P2 importPairToken: private DHT enabled, hostname={}, fp={}",
+             accountId, p.hostname, p.fingerprint);
+    return ret;
+}
+
+std::map<std::string, std::string>
+p2SelfTest()
+{
+    auto r = jami::p2::pairTokenSelfTest();
+    return {{"status", r.fail == 0 ? "PASS" : "FAIL"},
+            {"pass", std::to_string(r.pass)},
+            {"fail", std::to_string(r.fail)},
+            {"details", r.details}};
+}
+
+std::map<std::string, std::string>
+getPrivateLinkStatus(const std::string& accountId)
+{
+    std::map<std::string, std::string> ret;
+    ret["dht"] = "unknown";
+    ret["bootstraps"] = "";
+    ret["ice"] = "unknown";
+    ret["note_delivered"] = "unknown";
+    ret["body_merged"] = "unknown";
+
+    auto vol = getVolatileAccountDetails(accountId);
+    auto it = vol.find("Account.registrationStatus");
+    if (it != vol.end())
+        ret["dht"] = it->second;
+    auto da = vol.find("Account.deviceAnnounced");
+    if (da != vol.end())
+        ret["device_announced"] = da->second;
+
+    auto details = getAccountDetails(accountId);
+    auto b = details.find("Account.hostname");
+    if (b != details.end())
+        ret["bootstraps"] = b->second;
+    auto p = details.find(jami::P2_PRIVATE_DHT_ONLY_KEY);
+    if (p != details.end())
+        ret["private_dht"] = p->second;
+
+    // ice / note_delivered / body_merged remain "unknown": the per-conversation
+    // connectivity API (getConversationConnectivity) is the authoritative
+    // source for those layers and is exposed separately to clients. Keeping
+    // this API to account-level facts avoids guessing and ABI churn.
+    return ret;
+}
