 #define XDG_DATA_HOME   (PROTECTED_GETENV("XDG_DATA_HOME"))
 #define XDG_CONFIG_HOME (PROTECTED_GETENV("XDG_CONFIG_HOME"))
 #define XDG_CACHE_HOME  (PROTECTED_GETENV("XDG_CACHE_HOME"))
+
+#ifdef _WIN32
+/* MSVC defines JAMI_*_HOME above; MinGW needs the same wide-string
+   environment lookup without the MSVC-only winGetEnv helper. */
+static std::wstring
+winGetEnvMinGW(const char* name)
+{
+    const char* value = getenv(name);
+    if (!value || !*value)
+        return std::wstring();
+    int size = MultiByteToWideChar(CP_UTF8, 0, value, -1, nullptr, 0);
+    if (size <= 1)
+        return std::wstring();
+    std::wstring result(static_cast<size_t>(size - 1), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, value, -1, &result[0], size);
+    return result;
+}
+
+#define JAMI_DATA_HOME   winGetEnvMinGW("JAMI_DATA_HOME")
+#define JAMI_CONFIG_HOME winGetEnvMinGW("JAMI_CONFIG_HOME")
+#define JAMI_CACHE_HOME  winGetEnvMinGW("JAMI_CACHE_HOME")
+#endif
 #else
 const wchar_t*
 winGetEnv(const wchar_t* name)
